// RemitWise database schema
// ---------------------------------------------------------------------------
// Uses SQLite for zero-config local demo. For production (Supabase / Postgres)
// switch `provider` to "postgresql" and point DATABASE_URL at your instance —
// the models below are written to be portable (no SQLite-only features).
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // Configurable auto-savings rate (0.20 = save 20% of every remittance)
  savingsRate  Float    @default(0.2)
  // Guided onboarding completed. Defaults true so pre-existing accounts skip it;
  // registration explicitly sets false until the wizard finishes.
  onboarded    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wallet       Wallet?
  transactions Transaction[]
  goals        Goal[]
  withdrawals  Withdrawal[]
  deposits     DepositIntent[]

  @@index([email])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  publicKey String
  // Encrypted at rest (AES-256-GCM). Testnet-only custodial storage — in
  // production use a KMS / non-custodial signing flow (Freighter) instead.
  secretKey String
  network   String   @default("testnet")

  // On-chain provisioning: funded via Friendbot + USDC trustline established.
  provisioned Boolean @default(false)

  // Fast-read mirror of on-chain state (source of truth is the Stellar vault):
  //   availableBalance = user's on-chain USDC · savingsBalance = vault savings_of(user)
  availableBalance Float @default(0)
  savingsBalance   Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id       String @id @default(cuid())
  userId   String
  // remittance_received | savings_allocation | goal_contribution | withdrawal
  type     String
  amount   Float
  asset    String @default("USDC")
  sender   String?
  memo     String?

  // Populated for remittance_received: the auto-savings split snapshot.
  savedAmount     Float?
  availableAmount Float?

  status     String  @default("completed")
  stellarTxId String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Goal {
  id            String  @id @default(cuid())
  userId        String
  name          String
  // emergency | education | medical | housing | business | vacation | custom
  category      String  @default("custom")
  targetAmount  Float
  currentAmount Float   @default(0)
  color         String  @default("#2563eb")
  isCompleted   Boolean @default(false)
  // Set when the user withdraws a funded goal from the vault to spendable USDC.
  claimedAt     DateTime?

  // --- Savings plan (drives how each saved amount is distributed) ---
  // high | medium | low — display + overflow ordering when a goal fills up.
  priority      String   @default("medium")
  // This goal's share of every saved amount, in percent (all active goals ≈ 100).
  // 0 across the board = fall back to remaining-need weighting.
  allocationPct Float    @default(0)
  // active | paused | archived — paused/archived goals receive no allocations.
  status        String   @default("active")
  targetDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A fiat cash-out: USDC leaves the user's wallet on-chain to the anchor's
// settlement account, and the anchor pays out local fiat (PHP, Phase 2) to the
// selected bank / e-wallet. The quote (FX, fees, payout) is snapshotted at
// confirmation time so history is auditable even after rates move.
model Withdrawal {
  id     String @id @default(cuid())
  userId String

  // Money — quote snapshot (all figures fixed at confirmation):
  amountUsdc Float // debited from the user's spendable USDC
  feeUsdc    Float // total fees in USDC (service + network)
  fxRate     Float // PHP per 1 USD applied
  payoutPhp  Float // what the bank account receives
  fxSource   String @default("reference") // "reflector" | "reference"

  // Payout destination (Philippines scope for Phase 2):
  railCode      String // e.g. "ph_bdo", "ph_gcash" — see lib/anchors/rails.ts
  railName      String // display name snapshot ("BDO Unibank")
  accountName   String
  accountNumber String

  // Lifecycle: pending_anchor → converting → paying_out → completed | failed
  status        String    @default("pending_anchor")
  anchorRef     String? // anchor's SEP-24 transaction id
  stellarTxId   String? // on-chain USDC transfer to the anchor
  failureReason String?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// A fiat on-ramp session: a sender abroad pays local fiat (USD, EUR, …) via
// the anchor's interactive flow; the anchor converts to USDC and it settles
// into the recipient's wallet through the standard remittance ingest path.
model DepositIntent {
  id     String @id @default(cuid())
  userId String // the RemitWise recipient

  // Quote snapshot at creation:
  amountFiat   Float
  fiatCurrency String // ISO code the sender pays in (USD, EUR, GBP, …)
  feeFiat      Float // anchor fee, in sender currency
  fxRate       Float // USD per 1 unit of sender currency
  amountUsdc   Float // USDC the recipient will receive

  senderName String?

  // Lifecycle: awaiting_payment → processing → completed | expired | failed
  status         String  @default("awaiting_payment")
  anchorRef      String?
  interactiveUrl String? // anchor-hosted page where the sender pays
  stellarTxId    String? // settlement tx once minted on-chain
  transactionId  String? // resulting remittance Transaction row
  failureReason  String?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Small key-value store for operational state (e.g. the Horizon payment
// listener's last processed cursor, so restarts replay nothing and miss nothing).
model SystemState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Immutable audit trail for financial and auth events. Append-only by
// convention — the app never updates or deletes rows.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // e.g. remittance.received, goal.withdraw, auth.login
  amount    Float?
  txHash    String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
