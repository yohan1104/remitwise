# --- Core ---
DATABASE_URL="file:./dev.db"
# 32+ byte random string. REQUIRED in production (app refuses insecure default).
AUTH_SECRET="your-long-random-secret-here"
# Optional: dedicated key for encrypting wallet secrets at rest. Falls back to AUTH_SECRET.
WALLET_ENCRYPTION_KEY=""

# --- Stellar ---
STELLAR_NETWORK="testnet"
# The values below are generated by `npm run stellar:bootstrap` into
# stellar.config.json for local dev. For production, set them here instead:
# STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
# STELLAR_SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
# STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# STELLAR_USDC_CODE="USDC"
# STELLAR_USDC_ISSUER=""
# STELLAR_SAC_CONTRACT_ID=""
# STELLAR_VAULT_CONTRACT_ID=""
# STELLAR_DISTRIBUTOR_PUBLIC=""
# STELLAR_DISTRIBUTOR_SECRET=""

# --- AI (optional) ---
# Leave AI_API_KEY blank to use the built-in deterministic insight engine.
AI_API_KEY=""
AI_API_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Machine-to-machine secret for the payment-ingest webhook (Horizon listener / anchor callbacks).
# Unset = ingest endpoint disabled. Generate: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=""
