# --- Core ---
DATABASE_URL="file:./dev.db"
# 32+ byte random string. REQUIRED in production (app refuses insecure default).
AUTH_SECRET="your-long-random-secret-here"
# Optional: dedicated key for encrypting wallet secrets at rest. Falls back to AUTH_SECRET.
WALLET_ENCRYPTION_KEY=""

# --- Stellar ---
STELLAR_NETWORK="testnet"
# The values below are generated by `npm run stellar:bootstrap` into
# stellar.config.json for local dev. For production, set them here instead:
# STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
# STELLAR_SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
# STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# STELLAR_USDC_CODE="USDC"
# STELLAR_USDC_ISSUER=""
# STELLAR_SAC_CONTRACT_ID=""
# STELLAR_VAULT_CONTRACT_ID=""
# STELLAR_DISTRIBUTOR_PUBLIC=""
# STELLAR_DISTRIBUTOR_SECRET=""

# --- Fiat ramps (SEP-24 anchor) ---
# "mock" (default) simulates a partner anchor with a realistic lifecycle.
# "sep24" talks to a real anchor: SEP-1 discovery + SEP-10 auth + SEP-24 flows.
ANCHOR_PROVIDER="mock"
# Required when ANCHOR_PROVIDER=sep24, e.g. "anchor.example.com"
ANCHOR_HOME_DOMAIN=""
# Fee schedule overrides (decimals; defaults shown). Ops-tunable, no deploy.
# FEE_OFFRAMP_SERVICE_PCT="0.006"
# FEE_OFFRAMP_SERVICE_MIN_USD="0.99"
# FEE_OFFRAMP_NETWORK_USD="0.10"
# FEE_ONRAMP_PCT="0.012"
# FEE_ONRAMP_FIXED_USD="0.99"
# QR payments: free between RemitWise accounts, this flat fee to an external
# Stellar address (collected to the treasury in the same transaction).
# FEE_TRANSFER_NETWORK_USD="0.10"
# Labelled reference rate used when the FX oracle lacks a PHP feed (testnet).
# FX_REFERENCE_USD_PHP="58.75"
# DANGER: permits a non-Circle USDC issuer on mainnet. Leave unset in production.
# ALLOW_UNKNOWN_ASSET="1"

# --- AI (optional) ---
# Leave AI_API_KEY blank to use the built-in deterministic insight engine.
AI_API_KEY=""
AI_API_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Machine-to-machine secret for the payment-ingest webhook (Horizon listener / anchor callbacks).
# Unset = ingest endpoint disabled. Generate: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=""
# Base URL the payment listener posts ingests to (worker-side).
# APP_URL="http://localhost:3000"
